# Copiar a .env y completar. Nunca subir .env al repositorio.

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_PORT=3306
DB_NAME=consultorio_odontologico

# Mínimo 32 caracteres aleatorios. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos, separados por coma
CORS_ORIGIN=http://localhost:4000,http://localhost:4200

# Número de proxies delante de la API (Nginx, balanceador). Vacío si no hay ninguno:
# activarlo sin proxy permite falsificar la IP y saltarse el límite de intentos.
TRUST_PROXY=

# Intentos FALLIDOS de login permitidos cada 15 minutos (opcionales)
LOGIN_MAX_INTENTOS_IP=20
LOGIN_MAX_INTENTOS_CUENTA=5
